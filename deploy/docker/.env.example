# DNS deste domínio deve apontar para o servidor Docker público.
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
# Origem exata da interface, sem barra final. Atualize após importar na Vercel.
FRONTEND_ORIGIN=https://SEU-DOMINIO
APITO_SIGNUP_CODE_SHA256=SUBSTITUA_PELO_HASH_SHA256_DO_SEU_CODIGO
# Troque os dois valores antes de iniciar. Nunca publique o arquivo .env.
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
VIKUNJA_SERVICE_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_64_CARACTERES
# O cadastro exige o código de proteção cujo hash foi configurado acima.
