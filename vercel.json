{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "deploy/vercel-api/Dockerfile"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install --global pnpm@12.16.1 && PUPPETEER_SKIP_DOWNLOAD=true pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [{"source": "/(.*)", "destination": "/index.html"}]
    }
  },
  "rewrites": [
    {"source": "/api/(.*)", "destination": {"service": "app"}},
    {"source": "/(.*)", "destination": {"service": "frontend"}}
  ]
}
